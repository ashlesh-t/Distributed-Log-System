# Copy this file to .env and fill in real values before running docker compose

# ── Security ──────────────────────────────────────────────────────────────────
# Random secret used to hash API keys — generate with: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY_SALT=change-me-in-production

# Secret required by admin endpoints (POST /admin/keys)
ADMIN_SECRET=change-me-in-production

# Key used to encrypt per-tenant webhook secrets at rest (must match across services)
WEBHOOK_ENCRYPTION_KEY=change-me-in-production

# Webhook target policy (default: public https only; metadata/link-local always blocked)
WEBHOOK_ALLOW_PRIVATE_TARGETS=false
WEBHOOK_ALLOW_HTTP=false

# Optional HMAC secret for the global outbound webhook
WEBHOOK_SECRET=

# ── Webhook (optional) ────────────────────────────────────────────────────────
# If set, the heartbeat_service will POST all node_down/node_up events here
WEBHOOK_URL=

# ── Restart backend ───────────────────────────────────────────────────────────
# "docker" for local Docker-based restart, "kubernetes" for K8s pod restart
RESTART_BACKEND=docker

# ── Kubernetes (only needed when RESTART_BACKEND=kubernetes) ──────────────────
K8S_NAMESPACE=distributed-logs

# ── Heartbeat tuning ──────────────────────────────────────────────────────────
HEARTBEAT_INTERVAL_SECONDS=5
HEARTBEAT_TIMEOUT_SECONDS=15

# ── Error-spike webhook event ─────────────────────────────────────────────────
# Fire error_spike when a node logs >= THRESHOLD ERRORs within WINDOW seconds
ERROR_SPIKE_THRESHOLD=20
ERROR_SPIKE_WINDOW_SECONDS=60
